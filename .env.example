# Inventory Platform — environment template (S0-02).
#
# Copy to `.env` for local development:      cp .env.example .env
# `.env` is gitignored; `.env.example` is the committed, reviewable template.
#
# EVERY VALUE BELOW IS A NON-SECRET DEV PLACEHOLDER (marked "DEV ONLY"). They exist so that the
# local compose stack and CI's `docker compose config -q` work out of the box without a committed
# secret. Do NOT use any of them outside a developer laptop:
#   * staging/prod inject real values from the CI secret store / secret manager (never files);
#   * JWTs, Dex client secrets, IdP connector secrets, DB/S3 passwords and API keys are secrets;
#   * secrets are never baked into images, stored in the DB (only `*_secret_ref` pointers) or logged.
# The platform settings object (`app/core/config.py`) reads these names (case-insensitive).
#
# Variable groups: runtime, API, PostgreSQL, Redis, Dex (shared dev issuer), MinIO/S3, compose.

# ------------------------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------------------------
# Deployment environment name used by diagnostics/gates: dev | staging | prod
ENV=dev
APP_NAME=inventory-platform
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------------------------
# API
# ------------------------------------------------------------------------------------------------
# Host port the local api container is published on (container always listens on 8000).
API_PORT=8000
# Optional command overrides (compose defaults are shown, commented out). Leave unset to use the
# image/dev defaults; set to point a service at a different entrypoint.
# API_COMMAND=uvicorn app.api.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=*
# WORKER_COMMAND=python -m app.workers.worker
# OUTBOX_RELAY_COMMAND=python -m app.workers.worker   # FS-00 replaces with the dedicated relay entrypoint
# WORKER_HEALTHCHECK_MATCH=app.workers.worker
# OUTBOX_RELAY_HEALTHCHECK_MATCH=app.workers.worker

# ------------------------------------------------------------------------------------------------
# Platform JWT sessions (Δ-SSO: the platform — not Dex — issues access/refresh tokens)
# ------------------------------------------------------------------------------------------------
# DEV ONLY signing secret. Production: read from the secret manager, rotate on schedule.
JWT_SECRET=dev-only-insecure-jwt-signing-secret-change-me
JWT_ISSUER=inventory-platform
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# ------------------------------------------------------------------------------------------------
# Operator-only account creation (bootstrap)
# ------------------------------------------------------------------------------------------------
# Empty disables /api/v1/bootstrap/*. In production set a random >=32-byte token (openssl rand -hex 48).
# This is the only credential that can create tenants and the first accounts directly.
SUPER_ADMIN_TOKEN=
# Optional local/test docs key; production requires this to retrieve /api/v1/openapi.json.
OPENAPI_API_KEY=
# true in production: ordinary tenant-admin account/invitation and tenant-provisioning routes also
# require SUPER_ADMIN_TOKEN (use the bootstrap API for all account creation).
ACCOUNT_CREATION_SUPER_ADMIN_ONLY=false
# Dev/test convenience only; set false in production so SSO JIT cannot create accounts.
SSO_JIT_PROVISIONING_ENABLED=true

# ------------------------------------------------------------------------------------------------
# PostgreSQL 16 (compose service `postgres`; one database, one schema per bounded context)
# ------------------------------------------------------------------------------------------------
# DEV ONLY local credentials. Keep DATABASE_URL consistent with these values when overriding them.
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory-dev-password
# Host port name (published as ${POSTGRES_PORT}:5432).
POSTGRES_PORT=5432
# Async SQLAlchemy URL. Inside compose the host is the service name `postgres`.
DATABASE_URL=postgresql+asyncpg://inventory:inventory-dev-password@postgres:5432/inventory

# ------------------------------------------------------------------------------------------------
# Redis 7 (RQ job queues + transactional-outbox event streams)
# ------------------------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ------------------------------------------------------------------------------------------------
# Dex — shared DEV/TEST OIDC issuer (one isolated issuer per ACTIVE tenant SSO connection in prod;
# see ops/dex/README.md and scripts/provision_sso_dex.sh)
# ------------------------------------------------------------------------------------------------
# Issuer contract pinned for the local stack (path-prefixed /dex).
DEX_ISSUER=http://localhost:5556/dex
DEX_WEB_HTTP=0.0.0.0:5556
DEX_ALLOWED_ORIGIN=http://localhost:8000
# Host port for the Dex container (issuer above is host-local, so keep 5556).
DEX_PORT=5556
# OIDC client = platform API. Must match app settings `dex_client_id`.
DEX_CLIENT_ID=inventory-platform
# DEV ONLY client secret (Dex reads it via `secretEnv`; prod: secret-manager value).
DEX_CLIENT_SECRET=dev-only-insecure-dex-client-secret-change-me
DEX_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
# Dev identity seeded by ops/dex/config.docker.yaml (password: dev-password; local only).
DEX_STATIC_EMAIL=dev@example.com
DEX_STATIC_USERNAME=dev
DEX_STATIC_USER_ID=dev-user-0001
# Dex PostgreSQL storage (database `dex`, created by ops/dex/initdb on first postgres init).
DEX_DB_HOST=postgres
DEX_DB_PORT=5432
DEX_DB_NAME=dex
DEX_DB_USER=inventory
# DEV ONLY; keep in sync with POSTGRES_PASSWORD.
DEX_DB_PASSWORD=inventory-dev-password
DEX_DB_SSL_MODE=disable
DEX_LOG_LEVEL=info
# Pin the Dex image (the reference model requires a tested 2.4x release).
DEX_IMAGE=ghcr.io/dexidp/dex:v2.41.1

# ------------------------------------------------------------------------------------------------
# MinIO / S3-compatible object storage (attachment bytes; metadata in Postgres)
# ------------------------------------------------------------------------------------------------
# Inside compose the endpoint is the service name `minio`; host access: http://localhost:9000.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=inventory-minio
S3_SECRET_KEY=dev-only-insecure-minio-secret-change-me
S3_BUCKET=inventory
# MinIO server credentials (keep S3_ACCESS_KEY/S3_SECRET_KEY consistent with these).
MINIO_ROOT_USER=inventory-minio
MINIO_ROOT_PASSWORD=dev-only-insecure-minio-secret-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# MinIO official community images were withdrawn from public registries in 2025; the Bitnami-legacy
# mirror below is pinned for local dev only. Production uses the platform's S3-compatible storage.
MINIO_IMAGE=bitnamilegacy/minio:2025.7.23-debian-12-r5

# ------------------------------------------------------------------------------------------------
# Compose
# ------------------------------------------------------------------------------------------------
# Per-builder isolation (Δ-PAR §7): one compose project/DB/volume set per builder.
COMPOSE_PROJECT_NAME=inv-dev
# Dockerfile target used by the compose stack: `runtime` for prod-shape; `dev` adds test tooling
# so the manifest L3 exit gates (`docker compose run --rm api pytest ...`) work in-container.
APP_BUILD_TARGET=dev
# Application image tag shared by api/worker/outbox-relay.
INVENTORY_IMAGE=inventory-platform-api:local
