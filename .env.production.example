# Production environment file for the VPS Docker Compose deployment.
# Copy to `.env.production` on the VPS (never commit it) and replace every CHANGE_ME value.
# The deploy workflow never writes this file; it must exist before the first deploy.

ENV=prod
APP_NAME=inventory-platform
API_PREFIX=/api/v1
LOG_LEVEL=INFO
DOMAIN=inventory.example.com

# PostgreSQL: owner/migration credentials + a non-superuser app login (RLS applies to the app login).
POSTGRES_DB=inventory
POSTGRES_USER=inventory_owner
POSTGRES_PASSWORD=CHANGE_ME_DB_OWNER_PASSWORD
APP_DB_USER=inventory_app
APP_DB_PASSWORD=CHANGE_ME_APP_LOGIN_PASSWORD
DATABASE_URL=postgresql+asyncpg://inventory_app:CHANGE_ME_APP_LOGIN_PASSWORD@postgres:5432/inventory
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://inventory_owner:CHANGE_ME_DB_OWNER_PASSWORD@postgres:5432/inventory

# Redis (queue + outbox streams)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# Platform JWT sessions
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SIGNING_SECRET
JWT_ISSUER=inventory-platform
JWT_AUDIENCE=inventory-platform-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Operator-only bootstrap credential. Generate with: openssl rand -hex 48
# This is the only credential that can create tenants/accounts through /api/v1/bootstrap/*.
SUPER_ADMIN_TOKEN=CHANGE_ME_SUPER_ADMIN_TOKEN_AT_LEAST_32_BYTES
# Dedicated API key required to fetch /api/v1/openapi.json (X-API-Key; >=32 chars).
OPENAPI_API_KEY=CHANGE_ME_OPENAPI_API_KEY_AT_LEAST_32_BYTES
# When true, ordinary tenant-admin account/invitation and tenant-provisioning routes also require
# the super-admin token. Keep true in production.
ACCOUNT_CREATION_SUPER_ADMIN_ONLY=true
# Keep false: accounts only via /api/v1/bootstrap/* (or invitation activation).
SSO_JIT_PROVISIONING_ENABLED=false

# SSO (optional). Configure per-tenant IdP/SSO connections after bootstrap. The dev Dex issuer is not
# part of the production compose stack; local login remains available unless disabled by tenant policy.
DEX_ISSUER=https://idp.example.com/dex
DEX_CLIENT_ID=inventory-platform
DEX_CLIENT_SECRET=CHANGE_ME_IDP_CLIENT_SECRET
DEX_REDIRECT_URI=https://inventory.example.com/api/v1/auth/sso/callback

# S3-compatible object storage for attachments. Set S3_ENDPOINT to external storage, or run the
# optional `storage` compose profile and use http://minio:9000.
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_BUCKET=inventory
