{
  "$id": "https://contracts.inventory-platform.local/replenishment.planning/replenishment.calculated/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "replenishment.planning@1.0.0 replenishment.calculated payload.",
  "properties": {
    "aggregate": {
      "additionalProperties": false,
