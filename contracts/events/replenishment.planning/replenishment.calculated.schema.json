        "type": {
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ],
      "type": "object"
    },
    "causation_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "applied_count": {
          "default": 0,
          "title": "Applied Count",
          "type": "integer"
        },
        "formula_version": {
          "title": "Formula Version",
          "type": "string"
        },
        "line_count": {
          "title": "Line Count",
          "type": "integer"
        },
        "replenishment_calculation_id": {
          "title": "Replenishment Calculation Id",
          "type": "string"
        },
        "skipped_manual_count": {
          "default": 0,
          "title": "Skipped Manual Count",
          "type": "integer"
        }
      },
      "required": [
        "replenishment_calculation_id",
        "formula_version",
        "line_count"
      ],
      "type": "object"
    },
    "event_id": {
      "format": "uuid",
      "type": "string"
    },
    "event_type": {
      "minLength": 3,
      "type": "string"
    },
    "event_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "type": "object"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    }
